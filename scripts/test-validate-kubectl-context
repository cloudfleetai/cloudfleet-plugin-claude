#!/usr/bin/env bash
# Test suite for the validate-kubectl-context hook.
#
# Cases that need a real cluster resolve against contexts discovered in the
# caller's kubeconfig and are skipped when none of that shape exists, so the
# suite stays useful on a machine with no CFKE access.

set -uo pipefail

HOOK="$(cd "$(dirname "$0")" && pwd)/validate-kubectl-context"
passed=0
failed=0
skipped=0

# Finds the first context whose server matches $1, or empty.
ctx_matching() {
    local pattern="$1" c s
    while IFS= read -r c; do
        s=$(kubectl config view --minify --context "$c" \
            -o jsonpath='{.clusters[0].cluster.server}' 2>/dev/null)
        case "$s" in *$pattern*) printf '%s' "$c"; return 0 ;; esac
    done < <(kubectl config get-contexts -o name 2>/dev/null)
    return 1
}

# expect <allow|block> <description> <command>
expect() {
    local want="$1" desc="$2" cmd="$3" got rc
    printf '%s' "$cmd" |
        jq -Rs '{tool_input: {command: .}}' |
        "$HOOK" >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 2 ] && got=block || got=allow
    if [ "$got" = "$want" ]; then
        printf '  ok       %s\n' "$desc"
        passed=$((passed + 1))
    else
        printf '  FAIL     %s (wanted %s, got %s)\n' "$desc" "$want" "$got"
        failed=$((failed + 1))
    fi
}

skip() {
    printf '  skip     %s\n' "$1"
    skipped=$((skipped + 1))
}

echo "Not a kubectl invocation:"
expect allow "commit message mentioning kubectl" \
    'git commit -m "fix kubectl context handling"'
expect allow "echo mentioning kubectl" \
    'echo "remember to run kubectl later"'
expect allow "grep for kubectl in the tree" \
    'grep -r kubectl ./skills'
expect allow "heredoc body containing a kubectl example" \
    "$(printf 'cat > /tmp/t.md <<%s\n# Tutorial\nkubectl get pods -n cnpg-system\n%s\n' "'EOF'" 'EOF')"
expect allow "tab-indented heredoc (<<-)" \
    "$(printf 'cat > /tmp/t.md <<-EOF\n\tkubectl delete ns prod\n\tEOF\n')"
expect allow "unquoted heredoc delimiter" \
    "$(printf 'cat > /tmp/t.md <<EOF\nkubectl apply -f x.yaml\nEOF\n')"

echo
echo "Bypasses that are known and accepted:"
expect allow "alias" 'k get pods'
expect allow "wrapper script" './deploy.sh'

echo
if cfke_ctx=$(ctx_matching 'cfke.io'); then
    echo "CFKE cluster, current domain:"
    expect allow "kubectl --context <cfke.io>" "kubectl --context $cfke_ctx get pods"
else
    echo "CFKE cluster, current domain:"
    skip "no .cfke.io context in kubeconfig"
fi

if legacy_ctx=$(ctx_matching 'cfke.cloudfleet.dev'); then
    expect allow "kubectl --context <legacy cfke.cloudfleet.dev>" \
        "kubectl --context $legacy_ctx get pods"
else
    skip "no .cfke.cloudfleet.dev context in kubeconfig"
fi

echo
echo "Non-CFKE cluster:"
if other_ctx=$(ctx_matching 'gke.goog' || ctx_matching 'eks.amazonaws.com'); then
    expect block "kubectl --context <non-CFKE>" "kubectl --context $other_ctx delete deploy/api"
    expect block "sudo kubectl --context <non-CFKE>" "sudo kubectl --context $other_ctx get nodes"
else
    skip "no non-CFKE context in kubeconfig"
fi

echo
echo "Unresolvable target allows, kubectl reports its own error:"
expect allow "--kubeconfig pointing at a missing file" \
    'kubectl --kubeconfig /tmp/does-not-exist.kubeconfig get pods'

echo
echo "Missing dependencies fail open:"
for missing in jq kubectl; do
    d=$(mktemp -d)
    for b in bash grep cat sed tr head cut awk jq kubectl; do
        [ "$b" = "$missing" ] && continue
        ln -s "$(command -v "$b")" "$d/$b" 2>/dev/null
    done
    printf '%s' 'kubectl get pods' |
        jq -Rs '{tool_input: {command: .}}' |
        env -i PATH="$d" HOME="$HOME" "$HOOK" >/dev/null 2>&1
    rc=$?
    if [ "$rc" -eq 0 ]; then
        printf '  ok       %s missing allows\n' "$missing"
        passed=$((passed + 1))
    else
        printf '  FAIL     %s missing exited %s, wanted 0\n' "$missing" "$rc"
        failed=$((failed + 1))
    fi
    rm -rf "$d"
done

echo
printf '%s passed, %s failed, %s skipped\n' "$passed" "$failed" "$skipped"
[ "$failed" -eq 0 ]
