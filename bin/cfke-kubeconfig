#!/usr/bin/env bash
# cfke-kubeconfig: manage isolated kubeconfig files for CFKE clusters.
#
# Usage:
#   cfke-kubeconfig get <cluster-id>    — ensure kubeconfig exists, print path
#   cfke-kubeconfig path <cluster-id>   — print path without fetching
#   cfke-kubeconfig clean               — remove all temporary kubeconfigs

set -euo pipefail

# A per-user directory rather than a shared one. On a multi-user host a
# predictable path in /tmp lets any local user read which clusters you touch, or
# replace the file your next `kubectl --kubeconfig` call trusts.
CFKE_DIR="${TMPDIR:-/tmp}"
CFKE_DIR="${CFKE_DIR%/}/cloudfleet-$(id -u)"

usage() {
  echo "Usage: cfke-kubeconfig <get|path|clean> [cluster-id]" >&2
  exit 1
}

ensure_dir() {
  mkdir -p "$CFKE_DIR"
  chmod 700 "$CFKE_DIR"
}

cmd_get() {
  local cluster_id="$1"
  local kubeconfig_path
  kubeconfig_path="$(cmd_path "$cluster_id")"

  if [ ! -f "$kubeconfig_path" ]; then
    ensure_dir
    (umask 077 && cloudfleet clusters kubeconfig "$cluster_id" --kubeconfig "$kubeconfig_path" >&2)
  fi

  echo "$kubeconfig_path"
}

cmd_path() {
  local cluster_id="$1"
  echo "${CFKE_DIR}/${cluster_id}.kubeconfig"
}

cmd_clean() {
  local count=0
  # Only ever removes files inside our own 0700 directory, so there is nothing
  # another user could have planted for us to delete.
  [ -d "$CFKE_DIR" ] || { echo "Removed 0 kubeconfig file(s)." >&2; return 0; }
  for f in "$CFKE_DIR"/*.kubeconfig; do
    [ -f "$f" ] || continue
    rm -f "$f"
    count=$((count + 1))
  done
  echo "Removed $count kubeconfig file(s)." >&2
}

[ $# -ge 1 ] || usage

case "$1" in
  get)
    [ $# -ge 2 ] || { echo "Error: cluster-id required" >&2; usage; }
    cmd_get "$2"
    ;;
  path)
    [ $# -ge 2 ] || { echo "Error: cluster-id required" >&2; usage; }
    cmd_path "$2"
    ;;
  clean)
    cmd_clean
    ;;
  *)
    usage
    ;;
esac
