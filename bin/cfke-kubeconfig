#!/bin/bash
# cfke-kubeconfig: manage isolated kubeconfig files for CFKE clusters.
#
# Usage:
#   cfke-kubeconfig get <cluster-id>    — ensure kubeconfig exists, print path
#   cfke-kubeconfig path <cluster-id>   — print path without fetching
#   cfke-kubeconfig clean               — remove all temporary kubeconfigs

set -euo pipefail

TMPDIR_PREFIX="/tmp/cloudfleet-"

usage() {
  echo "Usage: cfke-kubeconfig <get|path|clean> [cluster-id]" >&2
  exit 1
}

cmd_get() {
  local cluster_id="$1"
  local kubeconfig_path="${TMPDIR_PREFIX}${cluster_id}.kubeconfig"

  if [ ! -f "$kubeconfig_path" ]; then
    cloudfleet clusters kubeconfig "$cluster_id" --kubeconfig "$kubeconfig_path" >&2
  fi

  echo "$kubeconfig_path"
}

cmd_path() {
  local cluster_id="$1"
  echo "${TMPDIR_PREFIX}${cluster_id}.kubeconfig"
}

cmd_clean() {
  local count=0
  for f in ${TMPDIR_PREFIX}*.kubeconfig; do
    [ -f "$f" ] || continue
    rm -f "$f"
    count=$((count + 1))
  done
  echo "Removed $count kubeconfig file(s)." >&2
}

[ $# -ge 1 ] || usage

case "$1" in
  get)
    [ $# -ge 2 ] || { echo "Error: cluster-id required" >&2; usage; }
    cmd_get "$2"
    ;;
  path)
    [ $# -ge 2 ] || { echo "Error: cluster-id required" >&2; usage; }
    cmd_path "$2"
    ;;
  clean)
    cmd_clean
    ;;
  *)
    usage
    ;;
esac
